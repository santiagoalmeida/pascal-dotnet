<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Framework-dependent but RID-specific: some DbXxx providers (e.g. Microsoft.Data.SqlClient)
         ship a generic "unsupported platform" stub unless the build resolves the actual
         platform implementation. $(NETCoreSdkRuntimeIdentifier) is whatever RID the local
         SDK detects, so this adapts automatically instead of hardcoding e.g. "linux-x64". -->
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PascalRuntime/PascalRuntime.csproj" />
  </ItemGroup>

</Project>
